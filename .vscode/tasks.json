{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "GiroBlu - Compilar",
            "type": "shell",
            "command": "javac",
            "args": [
                "-encoding",
                "UTF-8",
                "-d",
                "${workspaceFolder}/bin",
                "-cp",
                "${workspaceFolder}/lib/junit-platform-console-standalone-1.11.4.jar",
                "${workspaceFolder}/src/apresentacao/Main.java",
                "${workspaceFolder}/src/apresentacao/JanelaPrincipal.java",
                "${workspaceFolder}/src/negocio/*.java",
                "${workspaceFolder}/src/negocio/excecao/*.java"
            ],
            "group": "build",
            "problemMatcher": "$javac"
        }
    ]
}
